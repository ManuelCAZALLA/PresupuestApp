    "clients.empty.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald du einen Kundennamen in einem Angebot angibst, erscheint der Kunde hier."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you add a client’s name to a quote, they will appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando pongas el nombre del cliente en un presupuesto, aparecerá aquí."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando agregues el nombre de un cliente a una cotización, aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un client apparaît ici dès que vous indiquez son nom dans un devis."
