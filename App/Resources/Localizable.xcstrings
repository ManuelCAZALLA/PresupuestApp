          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le PDF contient du texte, mais aucun article avec un prix n’a été détecté. Vérifiez que chaque article et son prix figurent sur la même ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il PDF contiene testo, ma non sono state rilevate voci con prezzo. Verifica che ogni voce e il relativo prezzo siano sulla stessa riga."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PDF tem texto, mas nenhum item com preço foi identificado. Confira se cada item e seu preço estão na mesma linha."
          }
        }
      }
    },
