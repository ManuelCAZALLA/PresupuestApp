    "importTariff.error.pdfNoRows" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das PDF enthält Text, aber es wurden keine Posten mit Preis erkannt. Prüfe, ob Posten und Preis in derselben Zeile stehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PDF contains text, but no priced items were detected. Check that each item and its price are on the same line."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El PDF tiene texto, pero no se han detectado partidas con precio. Revisa que cada partida y su precio estén en la misma línea."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
