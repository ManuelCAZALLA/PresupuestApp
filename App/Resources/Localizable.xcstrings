        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il cliente apparirà qui quando ne inserirai il nome in un preventivo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cliente aparecerá aqui quando você informar o nome dele em um orçamento."
          }
        }
