{
  "_comment": "Casos de evaluación del motor. Catálogo: catalog_fontaneria.sample.json. Estados: auto | ambiguous | none.",
  "catalog": "catalog_fontaneria.sample.json",
  "cases": [
    { "id": "c01", "input": "cuatro urinarios",
      "expect": [ { "item": "urinario", "qty": 4, "status": "auto" } ] },
    { "id": "c02", "input": "4 urinarios",
      "expect": [ { "item": "urinario", "qty": 4, "status": "auto" } ] },
    { "id": "c03", "input": "cuarenta urinarios",
      "expect": [ { "item": "urinario", "qty": 40, "status": "auto" } ] },
    { "id": "c04", "input": "un inodoro",
      "expect": [ { "item": "inodoro", "qty": 1, "status": "auto" } ] },
    { "id": "c05", "input": "dos wc",
      "expect": [ { "item": "inodoro", "qty": 2, "status": "auto" } ] },
    { "id": "c06", "input": "un par de inodoros",
      "expect": [ { "item": "inodoro", "qty": 2, "status": "auto" } ] },
    { "id": "c07", "input": "un plato de ducha de 90",
      "expect": [ { "item": "plato-ducha-90", "qty": 1, "status": "auto" } ] },
    { "id": "c08", "input": "un plato de ducha",
      "expect": [ { "status": "ambiguous", "qty": 1, "candidatesInclude": ["plato-ducha-90", "plato-ducha-120"] } ] },
    { "id": "c09", "input": "plato de ducha de 120 centímetros",
      "expect": [ { "item": "plato-ducha-120", "qty": 1, "status": "auto", "assumedQuantity": true } ] },
    { "id": "c10", "input": "un termo",
      "expect": [ { "status": "ambiguous", "qty": 1, "candidatesInclude": ["termo-50l", "termo-80l", "termo-100l"] } ] },
    { "id": "c11", "input": "un termo de 80 litros",
      "expect": [ { "item": "termo-80l", "qty": 1, "status": "auto" } ] },
    { "id": "c12", "input": "un calentador de 100",
      "expect": [ { "item": "termo-100l", "qty": 1, "status": "auto" } ] },
    { "id": "c13", "input": "un termo de 60 litros",
      "expect": [ { "statusIn": ["ambiguous", "none"], "qty": 1, "mustNotAuto": ["termo-50l", "termo-80l", "termo-100l"] } ] },
    { "id": "c14", "input": "4 urinarios, un plato de ducha de 90 y un termo de 80",
      "expect": [
        { "item": "urinario", "qty": 4, "status": "auto" },
        { "item": "plato-ducha-90", "qty": 1, "status": "auto" },
        { "item": "termo-80l", "qty": 1, "status": "auto" } ] },
    { "id": "c15", "input": "dos grifos de lavabo",
      "expect": [ { "item": "grifo-lavabo", "qty": 2, "status": "auto" } ] },
    { "id": "c16", "input": "un grifo",
      "expect": [ { "status": "ambiguous", "qty": 1, "candidatesInclude": ["grifo-lavabo", "grifo-ducha"] } ] },
    { "id": "c17", "input": "media docena de grifos de lavabo",
      "expect": [ { "item": "grifo-lavabo", "qty": 6, "status": "auto" } ] },
    { "id": "c18", "input": "10 metros de tubo de 20",
      "expect": [ { "item": "tubo-pex-20", "qty": 10, "unit": "m", "status": "auto" } ] },
    { "id": "c19", "input": "veinte metros de tubo de 25",
      "expect": [ { "item": "tubo-pex-25", "qty": 20, "unit": "m", "status": "auto" } ] },
    { "id": "c20", "input": "tres horas de mano de obra",
      "expect": [ { "item": "mano-obra-hora", "qty": 3, "unit": "h", "status": "auto" } ] },
    { "id": "c21", "input": "dos coma cinco horas de mano de obra",
      "expect": [ { "item": "mano-obra-hora", "qty": 2.5, "unit": "h", "status": "auto" } ] },
    { "id": "c22", "input": "un desatasco",
      "expect": [ { "item": "desatasco", "qty": 1, "status": "auto" } ] },
    { "id": "c23", "input": "desatasco",
      "expect": [ { "item": "desatasco", "qty": 1, "status": "auto", "assumedQuantity": true } ] },
    { "id": "c24", "input": "una piscina",
      "expect": [ { "status": "none", "qty": 1 } ] },
    { "id": "c25", "input": "plato de ducha de 90 y mampara",
      "expect": [
        { "item": "plato-ducha-90", "qty": 1, "status": "auto", "assumedQuantity": true },
        { "item": "mampara-ducha", "qty": 1, "status": "auto", "assumedQuantity": true } ] },
    { "id": "c26", "input": "cambiar un sifón de lavabo",
      "expect": [ { "item": "sifon", "qty": 1, "status": "auto" } ] },
    { "id": "c27", "input": "un termo de 80 litros más el desplazamiento",
      "expect": [
        { "item": "termo-80l", "qty": 1, "status": "auto" },
        { "item": "desplazamiento", "qty": 1, "status": "auto", "assumedQuantity": true } ] },
    { "id": "c28", "input": "3 inodoros + 2 urinarios",
      "expect": [
        { "item": "inodoro", "qty": 3, "status": "auto" },
        { "item": "urinario", "qty": 2, "status": "auto" } ] },
    { "id": "c29", "input": "monomando ducha",
      "expect": [ { "item": "grifo-ducha", "qty": 1, "status": "auto", "assumedQuantity": true } ] },
    { "id": "c30", "input": "diez metros cuadrados de baldosa",
      "expect": [ { "status": "none", "qty": 10, "unit": "m2" } ] }
  ]
}
